{
  "name": "xid-ts",
  "type": "module",
  "version": "1.3.1",
  "author": "0xZensh <txr1883@gmail.com>",
  "description": "xid is a globally unique id generator thought for the web. A Typescript port of https://github.com/rs/xid.",
  "license": "MIT",
  "homepage": "https://github.com/yiwen-ai/xid-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiwen-ai/xid-ts.git"
  },
  "files": [
    "dist"
  ],
  "unpkg": "./dist/esm/index.js",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig-cjs.json && node scripts/fix-cjs.mjs",
    "test:dist": "node scripts/test-dist.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit -p tsconfig.json && prettier --check src scripts",
    "format": "prettier --write src scripts",
    "ncu": "npx npm-check-updates -u",
    "test": "vitest src --coverage --run"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "cborg": "^5.1.7",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "xid",
    "unique",
    "uuid"
  ]
}