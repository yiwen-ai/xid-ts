{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "rootDir": "src",
    "outDir": "dist/esm",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "node_modules", "coverage", "dist", "debug"]
}
